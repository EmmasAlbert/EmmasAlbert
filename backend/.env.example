# 环境变量配置文件示例
# 复制此文件为 .env 并修改相应配置

# 应用配置
APP_NAME=Basketball Training Assistant
APP_VERSION=1.0.0
DEBUG=True

# 数据库配置
DATABASE_URL=mysql+pymysql://basketball_user:basketball_pass@localhost:3306/basketball_training

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT配置
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# MinIO配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_VIDEOS=training-videos
MINIO_BUCKET_IMAGES=training-images

# AI模型配置
YOLO_MODEL_PATH=./models/yolov8n.pt
POSE_MODEL=mediapipe

# 文件上传配置
MAX_UPLOAD_SIZE=524288000
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov,.mkv
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.gif

# Celery配置
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS配置（多个域名用逗号分隔）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
